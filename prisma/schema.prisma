// ETW — Eye The Wealth | Prisma Schema
// SQLite for local dev — all types chosen to be PostgreSQL-compatible.
// To migrate to PostgreSQL: change provider to "postgresql" and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMERATIONS (stored as String; validated in code — SQLite has no native enum)
// ─────────────────────────────────────────────────────────────────────────────
// Role:                    "ADMIN" | "EDITOR" | "VIEWER"
// VerificationStatus:      "VERIFIED" | "UNVERIFIED" | "ESTIMATED" | "NOT_DISCLOSED" | "SAMPLE"
// NgoVerificationStatus:   "Verified" | "Unverified"
// EmergencyNgoStatus:      "CONFIRMED_RESPONDING" | "OPERATING_NEARBY"
// DisasterType:            "FLOOD" | "EARTHQUAKE" | "CYCLONE" | "LANDSLIDE" | "FIRE" | "DROUGHT" | "OTHER"
// CaseStatus:              "DOCUMENTED" | "REPORTED_MEDIA" | "ILLUSTRATIVE"
// EntityType:              "PERSON" | "COMPANY" | "TRUST" | "FOUNDATION" | "NGO" | "PROJECT" | "REGION" | "OTHER" | "UNKNOWN"
// AuditAction:             "CREATE" | "UPDATE" | "DELETE"
// DonationStatus:          "CREATED" | "PAID" | "FAILED" | "REFUNDED"
// SourceClassification:    "Official government record" | "Public filing" | "NGO annual report"
//                          | "CSR disclosure" | "Foreign contribution disclosure"
//                          | "Audited financial statement" | "NGO website"
//                          | "ETW platform record" | "Other verified public source"

// ─────────────────────────────────────────────────────────────────────────────
// ROVER MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  id          String      @id @default(cuid())
  code        String      @unique // ISO 3166-1 alpha-3, e.g. "IND"
  code2       String      @unique // ISO 3166-1 alpha-2, e.g. "IN"
  name        String
  region      String?
  incomeLevel String?
  capitalCity String?
  longitude   Float?
  latitude    Float?
  flagEmoji   String?
  population  Float?      // latest known population
  isAggregate Boolean     @default(false) // true = World Bank aggregate/group, skip in globe
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  dataPoints  DataPoint[]
  comparisons CompareSelection[]
  regionMemberships RegionCountry[]

  @@index([code])
  @@index([name])
  @@index([isAggregate])
}

// Region/Group: World Bank regions, income groups, UN sub-regions
model Region {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  // Type: "wb_region" | "wb_income" | "un_subregion" | "continent" | "custom"
  type        String
  description String?
  wbCode      String?  // World Bank aggregate code (e.g. "SSA")
  createdAt   DateTime @default(now())

  countries   RegionCountry[]

  @@index([slug])
  @@index([type])
}

model RegionCountry {
  id        String  @id @default(cuid())
  regionId  String
  region    Region  @relation(fields: [regionId], references: [id])
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  @@unique([regionId, countryId])
  @@index([regionId])
  @@index([countryId])
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique // "Wealth", "GDP", "Poverty", etc.
  slug        String      @unique
  description String?
  displayOrder Int        @default(0)
  createdAt   DateTime    @default(now())

  indicators  Indicator[]
}

model Indicator {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  definition        String            // What this indicator measures
  methodology       String?           // How it is calculated
  unit              String            // e.g. "% of GDP", "USD", "per 1,000 live births"
  displayUnit       String?           // Shorter display unit, e.g. "$" or "per 1k"
  // Polarity: "POSITIVE" | "NEGATIVE" | "NEUTRAL"
  polarity          String            @default("NEUTRAL")
  polarityRationale String?           // Why high/low is good/bad/neutral
  worldBankCode     String?           // e.g. "NY.GDP.MKTP.CD"
  imfCode           String?           // IMF DataMapper indicator code
  whoCode           String?
  oecdCode          String?
  isWealth          Boolean           @default(false)
  hasManualData     Boolean           @default(false)
  displayOrder      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  dataPoints        DataPoint[]
  interpretations   EtwInterpretation[]
  compareSelections CompareSelection[]

  @@index([categoryId])
  @@index([slug])
  @@index([worldBankCode])
  @@index([imfCode])
}

model DataPoint {
  id                 String    @id @default(cuid())
  indicatorId        String
  indicator          Indicator @relation(fields: [indicatorId], references: [id])
  countryId          String
  country            Country   @relation(fields: [countryId], references: [id])
  value              Float?    // null = "Not publicly disclosed"
  unit               String?
  year               Int
  sourceId           String?
  source             Source?   @relation(fields: [sourceId], references: [id])
  sourceUrl          String?   // Exact URL to the data series/page
  collectionDate     DateTime? // When ETW fetched this
  fetchedFromUrl     String?   // Exact API URL used (for audit)
  // VerificationStatus: OFFICIAL | ESTIMATED | NOT_DISCLOSED | SAMPLE | UNVERIFIED
  verificationStatus String    @default("UNVERIFIED")
  isProjection       Boolean   @default(false) // IMF projected years
  isSampleData       Boolean   @default(false)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([indicatorId, countryId, year, sourceId])
  @@index([countryId])
  @@index([indicatorId])
  @@index([year])
  @@index([verificationStatus])
  @@index([indicatorId, year])
  @@index([countryId, indicatorId])
}

model Source {
  id           String      @id @default(cuid())
  name         String      @unique // "World Bank", "IMF", "WHO", etc.
  shortName    String?
  url          String
  description  String?
  isOfficial   Boolean     @default(true)
  createdAt    DateTime    @default(now())

  dataPoints   DataPoint[]
  transactions Transaction[]
  ngoFinancials NgoFinancialYear[]
}

model EtwInterpretation {
  id           String    @id @default(cuid())
  indicatorId  String
  indicator    Indicator @relation(fields: [indicatorId], references: [id])
  text         String    // The ETW analysis text
  factors      String?   // JSON array of factors as text
  lastReviewed DateTime  @default(now())
  reviewedBy   String?   // Editor user id
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([indicatorId])
}

model CompareSelection {
  id          String    @id @default(cuid())
  sessionId   String?   // anonymous session tracking (optional)
  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id])
  countryId   String
  country     Country   @relation(fields: [countryId], references: [id])
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRIBUTOR MODULE — REFERENCE DATA
// ─────────────────────────────────────────────────────────────────────────────

// 36 Maharashtra districts with aliases and adjacency
model District {
  id           String   @id @default(cuid())
  name         String   @unique // Canonical name
  aliases      String   @default("[]") // JSON array of alternate spellings
  adjacentTo   String   @default("[]") // JSON array of canonical district names
  division     String?  // Revenue division
  headquarters String?  // District headquarters city
  createdAt    DateTime @default(now())

  ngoDistricts NgoDistrict[]

  @@index([name])
}

// NGO contribution categories (for Contributor module)
model NgoCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  ngoLinks     NgoNgoCategory[]

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRIBUTOR MODULE — NGOs
// ─────────────────────────────────────────────────────────────────────────────

model Ngo {
  id                    String             @id @default(cuid())
  name                  String
  slug                  String             @unique
  // Official IDs
  darpanId              String?            // NITI Aayog / NGO Darpan Unique ID
  registrationNumber    String?
  registrationAuthority String?            // "Charity Commissioner" | "Registrar of Societies" | "RoC" etc.
  registrationAct       String?            // "Bombay Public Trusts Act" | "Societies Registration Act" | etc.
  registrationType      String?            // "Trust" | "Society" | "Section 8 Company" | "Other"
  registrationDate      DateTime?

  // Location
  address               String?
  city                  String?
  state                 String             @default("Maharashtra")
  pincode               String?
  primaryDistrict       String?            // Canonical district name (denormalized for speed)
  district              String?            // Canonical district name

  // Public-facing info
  website               String?
  officialDonationUrl   String?            // Source-backed external donation page URL
  categories            String?            // JSON array of category names or slugs for fast search/filtering
  areasOfWork           String?            // JSON array of freetext areas

  // Contacts (organization-level only — no personal phone/email)
  orgContacts           String?            // JSON: [{type, value, sourceUrl}] — org email/phone only

  // Key people (name+role+sourceUrl required per spec)
  keyPeople             String?            // JSON: [{name, role, sourceUrl}]

  // Financial transparency
  taxExemptionInfo      String?            // JSON: {has80G, has12A, sourceUrl} — only with source

  // Payment via ETW
  paymentEnabled        Boolean            @default(false) // ADMIN-only; requires consent
  consentDocumentUrl    String?            // URL to signed agreement
  settlementMethod      String?            // "bank_transfer" | "razorpay_route"
  accountRef            String?            // Encrypted account reference (never logged)

  // Provenance
  sourceName            String?
  sourceUrl             String?
  sourceClassification  String?            // See SourceClassification enum comment
  retrievedAt           DateTime?
  lastVerifiedAt        DateTime?
  importBatchId         String?
  importBatch           ImportBatch?       @relation(fields: [importBatchId], references: [id])

  // Status
  isActive              Boolean            @default(true)
  isSampleData          Boolean            @default(false) // MUST be false for real records
  verificationStatus    String             @default("Unverified") // "Verified" | "Unverified"
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relations
  districts             NgoDistrict[]
  categoryLinks         NgoNgoCategory[]
  financialYears        NgoFinancialYear[]
  transactions          Transaction[]
  emergencyMatches      EmergencyNgoMatch[]
  donations             Donation[]

  @@index([primaryDistrict])
  @@index([district])
  @@index([registrationNumber])
  @@index([darpanId])
  @@index([slug])
  @@index([verificationStatus])
  @@index([isSampleData])
}

// Many-to-many: Ngo ↔ District (an NGO can operate in multiple districts)
model NgoDistrict {
  id         String   @id @default(cuid())
  ngoId      String
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([ngoId, districtId])
  @@index([ngoId])
  @@index([districtId])
}

// Many-to-many: Ngo ↔ NgoCategory
model NgoNgoCategory {
  id         String      @id @default(cuid())
  ngoId      String
  ngo        Ngo         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  categoryId String
  category   NgoCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([ngoId, categoryId])
  @@index([ngoId])
  @@index([categoryId])
}

model NgoFinancialYear {
  id                   String   @id @default(cuid())
  ngoId                String
  ngo                  Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  financialYear        String   // e.g. "2022-23"

  // All financial fields nullable — null = "Not publicly disclosed"
  totalIncome          Float?
  totalExpenditure     Float?
  donations            Float?
  grants               Float?
  csrFunding           Float?
  governmentFunding    Float?
  foreignContributions Float?   // FCRA total
  assets               Float?
  liabilities          Float?
  adminExpenditure     Float?
  programExpenditure   Float?

  // Provenance (required)
  sourceName           String?
  sourceUrl            String?
  sourceClassification String?  // See SourceClassification enum comment
  sourceFile           String?  // Filename of uploaded/downloaded document
  pageReference        String?  // Page/section in source document
  documentUrl          String?  // Direct link to the filing document
  retrievedAt          DateTime?
  lastVerifiedAt       DateTime?
  importBatchId        String?
  importBatch          ImportBatch? @relation(fields: [importBatchId], references: [id])
  sourceId             String?
  source               Source?  @relation(fields: [sourceId], references: [id])

  verificationStatus   String   @default("Unverified")
  isSampleData         Boolean  @default(false)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([ngoId, financialYear])
  @@index([ngoId])
  @@index([financialYear])
}

model Transaction {
  id                   String           @id @default(cuid())
  ngoId                String
  ngo                  Ngo              @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  date                 DateTime?        // Actual date if known
  financialYear        String?          // e.g. "2022-23"

  // Parties (only publicly disclosed info)
  senderName           String?
  senderType           String?          // "Government" | "Corporate" | "Individual" | "Foreign" | "NGO"
  recipientName        String?
  recipientType        String?

  amount               Float?           // null if not publicly disclosed
  currency             String           @default("INR")
  purpose              String?
  transactionType      String?          // "Grant" | "Donation" | "CSR" | "FCRA" | "Government"
  isEstimate           Boolean          @default(false) // true = "Estimated" label

  // Provenance (required — no sourceUrl = rejected on import)
  sourceName           String
  sourceUrl            String
  sourceClassification String?
  sourceFile           String?
  pageReference        String?
  retrievedAt          DateTime?
  lastVerifiedAt       DateTime?
  importBatchId        String?
  importBatch          ImportBatch?     @relation(fields: [importBatchId], references: [id])
  sourceId             String?
  source               Source?          @relation(fields: [sourceId], references: [id])
  evidenceDocumentId   String?
  evidenceDocument     EvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id])

  verificationStatus   String           @default("Unverified")
  isSampleData         Boolean          @default(false)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([ngoId])
  @@index([financialYear])
  @@index([verificationStatus])
}

model EvidenceDocument {
  id            String        @id @default(cuid())
  title         String
  documentType  String?       // "Annual Report" | "FCRA Return" | "CSR Filing" | "Court Order" etc.
  url           String
  sourceOrg     String?
  publishedDate DateTime?
  retrievedDate DateTime?
  isSampleData  Boolean       @default(false)
  createdAt     DateTime      @default(now())

  transactions  Transaction[]
  emergencyMatches EmergencyNgoMatch[]
  caseEvidence  CaseEvidence[]
}

// ─────────────────────────────────────────────────────────────────────────────
// DATA PIPELINE
// ─────────────────────────────────────────────────────────────────────────────

model ImportBatch {
  id              String   @id @default(cuid())
  source          String   // "DARPAN_BULK" | "DARPAN_SCRAPER" | "MANUAL_CSV" | "FCRA_CSV" | "CSR_CSV" | "MANUAL_FORM"
  fileName        String?  // Original filename (if file-based)
  totalRows       Int      @default(0)
  acceptedRows    Int      @default(0)
  rejectedRows    Int      @default(0)
  duplicateRows   Int      @default(0)
  validationReport String? // JSON array of {row, status, reasons}
  status          String   @default("PENDING") // "PENDING" | "RUNNING" | "DONE" | "FAILED"
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  startedByUserId String?

  ngos            Ngo[]
  financials      NgoFinancialYear[]
  transactions    Transaction[]

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// EMERGENCY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Emergency {
  id               String             @id @default(cuid())
  title            String             // e.g. "Flood — Kolhapur District"
  // DisasterType: FLOOD | EARTHQUAKE | CYCLONE | LANDSLIDE | FIRE | DROUGHT | OTHER
  disasterType     String
  affectedDistricts String            // JSON array of canonical district names
  severity         String?            // "Low" | "Moderate" | "Severe" | "Extreme"
  description      String?
  reportedAt       DateTime
  resolvedAt       DateTime?
  // PENDING_REVIEW → ACTIVE (admin approved) | REJECTED
  reviewStatus     String             @default("PENDING_REVIEW")
  isActive         Boolean            @default(false) // true only after ADMIN approves
  isSimulation     Boolean            @default(false) // ENABLE_SIMULATION=true only
  sourceName       String
  sourceUrl        String
  sourceEventId    String?            @unique // For deduplication
  rawAlertData     String?            // JSON of the original alert
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?            // User id
  approvedBy       String?            // User id
  approvedAt       DateTime?

  ngoMatches       EmergencyNgoMatch[]

  @@index([isActive])
  @@index([reviewStatus])
  @@index([disasterType])
  @@index([reportedAt])
}

model EmergencyNgoMatch {
  id                String            @id @default(cuid())
  emergencyId       String
  emergency         Emergency         @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  ngoId             String
  ngo               Ngo               @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  // Status: CONFIRMED_RESPONDING | OPERATING_NEARBY
  // CONFIRMED_RESPONDING requires evidenceUrl + evidenceDate
  status            String            @default("OPERATING_NEARBY")
  matchReason       String?           // "district" | "neighbouring" | "relief_specialization"
  matchConfidence   String?           // "HIGH" | "MEDIUM" | "LOW"
  evidenceDocumentId String?
  evidenceDocument  EvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id])
  evidenceUrl       String?           // Required for CONFIRMED_RESPONDING
  evidenceDate      DateTime?         // Required for CONFIRMED_RESPONDING
  addedBy           String?           // User id
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([emergencyId, ngoId])
  @@index([emergencyId])
  @@index([ngoId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENTS (Razorpay, INR only)
// ─────────────────────────────────────────────────────────────────────────────

model Donation {
  id               String    @id @default(cuid())
  ngoId            String
  ngo              Ngo       @relation(fields: [ngoId], references: [id])
  // Status: CREATED → PAID | FAILED → REFUNDED
  status           String    @default("CREATED")
  amountPaise      Int       // Amount in paise (INR × 100) — avoids float precision issues
  currency         String    @default("INR")
  donorName        String?   // Null if anonymous
  donorEmail       String?   // Null if anonymous — never exposed publicly
  isAnonymous      Boolean   @default(false)
  isTestMode       Boolean   @default(true) // True for test/dev; never shown publicly

  // Razorpay references
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  razorpaySignature String?  // Stored for audit only

  // Idempotency
  idempotencyKey   String    @unique @default(cuid())

  // Receipt
  receiptUrl       String?
  financialYear    String?   // e.g. "2024-25"

  // Refund
  refundedAt       DateTime?
  refundedBy       String?   // Admin user id
  refundReason     String?
  razorpayRefundId String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  webhookLogs      WebhookLog[]

  @@index([ngoId])
  @@index([status])
  @@index([isTestMode])
  @@index([razorpayOrderId])
}

model WebhookLog {
  id              String    @id @default(cuid())
  // x-razorpay-event-id for idempotency
  razorpayEventId String?   @unique
  eventType       String    // "payment.captured" | "payment.failed" | "refund.processed"
  donationId      String?
  donation        Donation? @relation(fields: [donationId], references: [id])
  rawBody         String    // JSON-serialized raw body (for audit)
  signatureValid  Boolean
  processed       Boolean   @default(false)
  processingError String?
  receivedAt      DateTime  @default(now())

  @@index([donationId])
  @@index([eventType])
  @@index([receivedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DE BASEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Entity {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  // EntityType: PERSON | COMPANY | TRUST | FOUNDATION | NGO | PROJECT | REGION | OTHER | UNKNOWN
  type        String
  location    String?
  jurisdiction String?
  description String?
  isPubliclyKnown Boolean         @default(false)
  isSampleData    Boolean         @default(false)
  sourceUrl   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  fromRelationships EntityRelationship[] @relation("FromEntity")
  toRelationships   EntityRelationship[] @relation("ToEntity")
}

model EntityRelationship {
  id                String   @id @default(cuid())
  fromEntityId      String
  fromEntity        Entity   @relation("FromEntity", fields: [fromEntityId], references: [id])
  toEntityId        String
  toEntity          Entity   @relation("ToEntity", fields: [toEntityId], references: [id])
  relationshipType  String   // "Investment" | "Donation" | "Loan" | "Ownership" | "Director" | etc.
  amount            Float?
  currency          String?  @default("INR")
  year              Int?
  description       String?
  isVerified        Boolean  @default(false)
  isGap             Boolean  @default(false) // true = "Not publicly traceable" node
  sourceUrl         String?
  evidenceNote      String?
  caseId            String?
  case              Case?    @relation(fields: [caseId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([caseId])
}

model Case {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  subtitle             String?
  // CaseStatus: DOCUMENTED | REPORTED_MEDIA | ILLUSTRATIVE
  status               String               @default("ILLUSTRATIVE")
  legalMechanism       String?
  transparencyGap      String?
  whatIsKnown          String?              // JSON array of strings
  whatCannotBeEstablished String?           // JSON array of strings
  educationalDisclaimer String?
  isSampleData         Boolean              @default(false)
  publishedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdBy            String?

  evidenceChain        CaseEvidence[]
  entityRelationships  EntityRelationship[]
}

model CaseEvidence {
  id                 String           @id @default(cuid())
  caseId             String
  case               Case             @relation(fields: [caseId], references: [id])
  entityName         String?
  transactionDesc    String?
  documentTitle      String?
  sourceName         String?
  sourceUrl          String?
  evidenceDate       DateTime?
  evidenceDocumentId String?
  evidenceDocument   EvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id])
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())

  @@index([caseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTHENTICATION & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Role: ADMIN | EDITOR | VIEWER
  role          String    @default("VIEWER")
  passwordHash  String?   // bcrypt hash, null for OAuth users
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // CREATE | UPDATE | DELETE
  entityType String   // "Ngo" | "Transaction" | "Case" | "Emergency" | "Donation" | etc.
  entityId   String
  before     String?  // JSON of state before change
  after      String?  // JSON of state after change
  changes    String?  // JSON diff summary
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model IngestionRun {
  id             String   @id @default(cuid())
  source         String   // "WorldBank" | "GDACS" | "USGS" | "DARPAN" | etc.
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  status         String   @default("RUNNING") // "RUNNING" | "SUCCESS" | "FAILED" | "PARTIAL"
  recordsAdded   Int      @default(0)
  recordsUpdated Int      @default(0)
  recordsSkipped Int      @default(0)
  errors         String?  // JSON array
  notes          String?

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model CorrectionRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  entityType String? // "NGO" | "Transaction" | "Financial" etc.
  entityId  String?
  status    String   @default("NEW") // "NEW" | "IN_REVIEW" | "RESOLVED" | "REJECTED"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entityType])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROVER — INDIVIDUAL WEALTH (People)
// ─────────────────────────────────────────────────────────────────────────────

model Person {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  nationality    String?
  birthYear      Int?
  description    String?
  isSampleData   Boolean          @default(false)
  isPublicFigure Boolean          @default(false)
  sourceUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  netWorthHistory PersonNetWorth[]
  companies       PersonCompany[]

  @@index([slug])
  @@index([nationality])
}

model PersonNetWorth {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id])
  year         Int
  value        Float
  currency     String   @default("USD")
  isEstimate   Boolean  @default(true)
  sourceName   String
  sourceUrl    String
  methodology  String?
  notes        String?
  isSampleData Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([personId])
  @@index([year])
}

model PersonCompany {
  id           String  @id @default(cuid())
  personId     String
  person       Person  @relation(fields: [personId], references: [id])
  companyName  String
  role         String?
  stakePercent Float?
  sourceUrl    String?

  @@index([personId])
}
